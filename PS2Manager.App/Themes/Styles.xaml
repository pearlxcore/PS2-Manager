<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:conv="clr-namespace:PS2Manager.App.Converters">

    <!--  Converters  -->
    <conv:PathToImageConverter x:Key="PathToImage" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
    <conv:NullToVisibilityConverter x:Key="NullToCollapsed" />
    <conv:NullToVisibilityConverter x:Key="NullToVisible" Invert="True" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:EnumDescriptionConverter x:Key="EnumText" />
    <conv:PlanStatusBrushConverter x:Key="PlanStatusBrush" />
    <conv:EqualsToBoolConverter x:Key="EqualsToBool" />
    <conv:EqualsToVisibilityConverter x:Key="EqualsToVis" />
    <conv:ZeroToVisibilityConverter x:Key="ZeroToVisible" />
    <conv:ZeroToVisibilityConverter x:Key="ZeroToCollapsed" Invert="True" />
    <conv:MultiplyConverter x:Key="CoverHeight" Factor="1.42" />

    <!--  Palette (on top of WPF-UI dark)  -->
    <SolidColorBrush x:Key="PanelBrush" Color="#FF1E1F24" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#FF2E3038" />
    <SolidColorBrush x:Key="CoverPlaceholderBrush" Color="#FF262830" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF9AA0AE" />
    <SolidColorBrush x:Key="ChipBrush" Color="#FF2A2D36" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF4CC38A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFF2B84B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFF0616D" />
    <SolidColorBrush x:Key="InfoBrush" Color="#FF5FA8FF" />
    <SolidColorBrush x:Key="EditedBrush" Color="#FFB48CFF" />

    <!--  Text  -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!--  Chip (small rounded tag)  -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ChipBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0,0,6,6" />
    </Style>

    <!--  Card panel  -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!--  Toolbar buttons  -->
    <Style x:Key="ToolbarButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Appearance" Value="Secondary" />
    </Style>

    <!--  Tool card (Tools page)  -->
    <Style x:Key="ToolCard" TargetType="ui:CardAction" BasedOn="{StaticResource {x:Type ui:CardAction}}">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

</ResourceDictionary>
