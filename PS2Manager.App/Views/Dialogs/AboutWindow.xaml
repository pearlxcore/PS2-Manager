<local:DialogWindow
    x:Class="PS2Manager.App.Views.Dialogs.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PS2Manager.App.Views.Dialogs"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="About PS2 Manager"
    Width="440"
    ResizeMode="NoResize"
    SizeToContent="Height">

    <StackPanel>
        <ui:TitleBar Title="About PS2 Manager" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Margin="24,8,24,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="80" Height="80" Source="/Assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="PS2 Manager" />
                    <TextBlock x:Name="VersionText" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Margin="0,2,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Copyright © pearlxcore" />
                </StackPanel>
            </Grid>

            <TextBlock Margin="0,20,0,0" Text="Credit to GameDB-PS2, xlenore, the OPL art database, PCSX2 and DiscUtils." TextWrapping="Wrap" />
            <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Not affiliated with Sony Interactive Entertainment." TextWrapping="Wrap" />

            <UniformGrid Margin="0,22,0,0" Columns="4">
                <ui:Button Margin="0,0,4,0" HorizontalAlignment="Stretch" Click="OnGitHub" Content="GitHub" />
                <ui:Button Margin="4,0" HorizontalAlignment="Stretch" Click="OnKofi" Content="Ko-fi" />
                <ui:Button Margin="4,0" HorizontalAlignment="Stretch" Click="OnReportBug" Content="Report bug" />
                <ui:Button Margin="4,0,0,0" HorizontalAlignment="Stretch" Click="OnClose" Content="Close" IsCancel="True" />
            </UniformGrid>
        </StackPanel>
    </StackPanel>
</local:DialogWindow>
