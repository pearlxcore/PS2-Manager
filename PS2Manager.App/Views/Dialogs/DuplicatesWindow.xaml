<local:DialogWindow
    x:Class="PS2Manager.App.Views.Dialogs.DuplicatesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PS2Manager.App.Views.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PS2Manager.App.ViewModels"
    Title="Find duplicates"
    Width="1100"
    Height="700"
    MinWidth="760"
    MinHeight="460"
    d:DataContext="{d:DesignInstance vm:DuplicatesViewModel}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Find duplicates" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,4,24,12" Orientation="Horizontal">
            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="Match" />
            <ComboBox Width="160" ItemsSource="{Binding MatchOptions}" SelectedItem="{Binding Match}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EnumText}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Muted}" Text="{Binding MatchHint}" />
        </StackPanel>

        <ui:DataGrid
            Grid.Row="2"
            Margin="24,0"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserSortColumns="False"
            GridLinesVisibility="None"
            HeadersVisibility="Column"
            ItemsSource="{Binding RowsView}"
            RowHeight="34">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Margin="4,12,0,4" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="{Binding Name}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="70" Header="Delete">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:DuplicateRow}">
                            <CheckBox HorizontalAlignment="Center" IsChecked="{Binding Delete, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="2*" Binding="{Binding Game.FileName}" Header="File" IsReadOnly="True" />
                <DataGridTextColumn Width="80" Binding="{Binding Game.SizeDisplay}" Header="Size" IsReadOnly="True" />
                <DataGridTextColumn Width="60" Binding="{Binding Game.Version}" Header="Ver" IsReadOnly="True" />
                <DataGridTextColumn Width="2*" Binding="{Binding Game.Directory}" Header="Folder" IsReadOnly="True" />
                <DataGridTemplateColumn Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:DuplicateRow}">
                            <ui:Button Padding="6,2" Appearance="Transparent" Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="Show in Explorer">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="FolderOpen24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </ui:DataGrid>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="24,14" Background="#FF17181C" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Margin="0,0,8,0" Click="OnClose" Content="Close" />
                    <ui:Button Appearance="Danger" Command="{Binding DeleteMarkedCommand}" Content="Delete marked">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Delete24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Muted}" Text="{Binding Summary}" />
            </DockPanel>
        </Border>
    </Grid>
</local:DialogWindow>
