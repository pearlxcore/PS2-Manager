<local:DialogWindow
    x:Class="PS2Manager.App.Views.Dialogs.ExportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PS2Manager.App.Views.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PS2Manager.App.ViewModels"
    Title="Export library"
    Width="560"
    Height="560"
    ResizeMode="NoResize"
    d:DataContext="{d:DesignInstance vm:ExportViewModel}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Export library" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,4,24,0">
            <TextBlock Style="{StaticResource SectionHeader}" Text="Games" />
            <RadioButton Margin="0,0,0,4" Content="{Binding AllText}" GroupName="Scope" IsChecked="{Binding Scope, Converter={StaticResource EqualsToBool}, ConverterParameter=All}" />
            <RadioButton Margin="0,0,0,4" Content="{Binding FilteredText}" GroupName="Scope" IsChecked="{Binding Scope, Converter={StaticResource EqualsToBool}, ConverterParameter=Filtered}" />
            <RadioButton Content="{Binding SelectedText}" GroupName="Scope" IsChecked="{Binding Scope, Converter={StaticResource EqualsToBool}, ConverterParameter=Selected}" IsEnabled="{Binding HasSelection}" />

            <TextBlock Margin="0,16,0,8" Style="{StaticResource SectionHeader}" Text="Columns" />
            <ItemsControl ItemsSource="{Binding Columns}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ExportColumnOption}">
                        <CheckBox Margin="0,0,0,4" Content="{Binding Header}" IsChecked="{Binding IsChecked}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="0,12,0,0" Style="{StaticResource Muted}" Text="Format is picked by the file type you save as: Excel (.xlsx), CSV or text." />
        </StackPanel>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="24,14" Background="#FF17181C" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0" Command="{Binding CancelCommand}" Content="Cancel" />
                <ui:Button Appearance="Primary" Command="{Binding ExportCommand}" Content="Export…" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</local:DialogWindow>
