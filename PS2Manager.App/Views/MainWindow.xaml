<ui:FluentWindow
    x:Class="PS2Manager.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:PS2Manager.App.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PS2Manager.App.ViewModels"
    Title="PS2 Manager"
    Width="1400"
    Height="860"
    MinWidth="980"
    MinHeight="600"
    d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
    ExtendsContentIntoTitleBar="True"
    Icon="/Assets/app.ico"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="TitleBar"
            Title="PS2 Manager"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            OpenPaneLength="210"
            PaneDisplayMode="Left">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Library" TargetPageType="{x:Type pages:LibraryPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Library24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Tools" TargetPageType="{x:Type pages:ToolsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Wrench24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="OPL Device" TargetPageType="{x:Type pages:OplPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="UsbStick24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings" TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <!--  Status bar  -->
        <Border
            Grid.Row="2"
            Padding="14,6"
            Background="#FF17181C"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding LibraryVm.CountText}" />
                    <TextBlock
                        Margin="16,0,0,0"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="{Binding Library.DatabaseStatus}" />
                    <TextBlock
                        Margin="16,0,0,0"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="{Binding BackgroundCrc.Status}"
                        ToolTip="Reading each game's boot file in the background for the PCSX2 CRC. Pauses during other tasks." />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Visibility="{Binding Activity.IsBusy, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        MaxWidth="520"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Text="{Binding Activity.Text}"
                        TextTrimming="CharacterEllipsis" />
                    <ProgressBar
                        Width="180"
                        Height="4"
                        VerticalAlignment="Center"
                        IsIndeterminate="{Binding Activity.IsIndeterminate}"
                        Maximum="1"
                        Value="{Binding Activity.Progress}" />
                    <ui:Button
                        Margin="10,0,0,0"
                        Padding="8,2"
                        Appearance="Transparent"
                        Command="{Binding Activity.CancelCommand}"
                        Content="Cancel"
                        FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <ui:ContentDialogHost
            x:Name="RootContentDialog"
            Grid.Row="0"
            Grid.RowSpan="3" />
    </Grid>
</ui:FluentWindow>
