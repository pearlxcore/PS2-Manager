<ui:FluentWindow
    x:Class="PS2Manager.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PS2Manager.App.ViewModels"
    Title="PS2 Manager"
    Width="1400"
    Height="860"
    MinWidth="980"
    MinHeight="600"
    d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
    ExtendsContentIntoTitleBar="True"
    Icon="/Assets/app.ico"
    Background="#FF141518"
    WindowBackdropType="None"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="TitleBar"
            Title="PS2 Manager"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!--  Navigation: every page stays loaded and is only shown/hidden, so switching is instant.  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel x:Name="NavPane" Width="210" Margin="6,0,6,8" ClipToBounds="True">
                <ui:Button DockPanel.Dock="Top" Margin="2,0,0,6" Padding="10,8" Appearance="Transparent" Click="OnTogglePane" ToolTip="Show or hide labels">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Navigation24" />
                    </ui:Button.Icon>
                </ui:Button>
                <RadioButton x:Name="NavSettings" AutomationProperties.Name="Settings" Checked="OnNavChecked" DockPanel.Dock="Bottom" Style="{StaticResource NavItem}" Tag="Settings">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Settings24" />
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Text="Settings" />
                    </StackPanel>
                </RadioButton>
                <Button AutomationProperties.Name="About" Click="OnAbout" DockPanel.Dock="Bottom" Style="{StaticResource NavAction}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Info24" />
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Text="About" />
                    </StackPanel>
                </Button>
                <Border Height="1" Margin="0,4" Background="{StaticResource PanelBorderBrush}" DockPanel.Dock="Bottom" />
                <StackPanel>
                    <RadioButton x:Name="NavLibrary" AutomationProperties.Name="Library" Checked="OnNavChecked" Style="{StaticResource NavItem}" Tag="Library">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Library24" />
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Text="Library" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton AutomationProperties.Name="Tools" Checked="OnNavChecked" Style="{StaticResource NavItem}" Tag="Tools">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Wrench24" />
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Text="Tools" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton AutomationProperties.Name="OPL Device" Checked="OnNavChecked" Style="{StaticResource NavItem}" Tag="Opl">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="UsbStick24" />
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Text="OPL Device" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>

            <Border
                Grid.Column="1"
                Background="#FF1B1C20"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
                <Grid x:Name="PageHost" />
            </Border>
            <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Column="1" />
        </Grid>

        <!--  Status bar  -->
        <Border
            Grid.Row="2"
            Padding="14,6"
            Background="#FF17181C"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding LibraryVm.CountText}" />
                    <TextBlock
                        Margin="16,0,0,0"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="{Binding Library.DatabaseStatus}" />
                    <TextBlock
                        Margin="16,0,0,0"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="{Binding BackgroundCrc.Status}"
                        ToolTip="Reading each game's boot file in the background for the PCSX2 CRC. Pauses during other tasks." />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Visibility="{Binding Activity.IsBusy, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        MaxWidth="520"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Text="{Binding Activity.Text}"
                        TextTrimming="CharacterEllipsis" />
                    <ProgressBar
                        Width="180"
                        Height="4"
                        VerticalAlignment="Center"
                        IsIndeterminate="{Binding Activity.IsIndeterminate}"
                        Maximum="1"
                        Value="{Binding Activity.Progress}" />
                    <ui:Button
                        Margin="10,0,0,0"
                        Padding="8,2"
                        Appearance="Transparent"
                        Command="{Binding Activity.CancelCommand}"
                        Content="Cancel"
                        FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <ui:ContentDialogHost
            x:Name="RootContentDialog"
            Grid.Row="0"
            Grid.RowSpan="3" />
    </Grid>
</ui:FluentWindow>
