<UserControl
    x:Class="PS2Manager.App.Views.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:PS2Manager.App.Converters"
    xmlns:core="clr-namespace:PS2Manager.Core.Models;assembly=PS2Manager.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PS2Manager.App.ViewModels"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    d:DataContext="{d:DesignInstance vm:LibraryViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    AllowDrop="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Shared context menu for grid and cover wall (DataContext = LibraryViewModel)  -->
        <ContextMenu x:Key="GameMenu">
            <MenuItem Command="{Binding EditInfoCommand}" Header="Edit game info…" InputGestureText="Enter">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Edit24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding ManageArtCommand}" Header="Covers &amp; art…">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ImageMultiple24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding DownloadArtForSelectionCommand}" Header="Download art">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ArrowDownload24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Command="{Binding RenameCommand}" Header="Rename…" InputGestureText="F2">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Rename24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding MoveToFoldersCommand}" Header="Move into folders…">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="FolderArrowRight24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding SendToOplCommand}" Header="Send to OPL device…">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="UsbStick24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Command="{Binding ComputeCrcCommand}" Header="Calculate CRC32">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Fingerprint24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding ShowInExplorerCommand}" Header="Show in Explorer">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Command="{Binding RemoveFromLibraryCommand}" Header="Remove from library">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Subtract24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding DeleteFilesCommand}" Header="Delete file (Recycle Bin)" InputGestureText="Del">
                <MenuItem.Icon>
                    <ui:SymbolIcon Foreground="{StaticResource DangerBrush}" Symbol="Delete24" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid Margin="18,8,18,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition x:Name="SplitterColumn" Width="12" />
            <ColumnDefinition x:Name="DetailsColumn" Width="340" MinWidth="260" MaxWidth="520" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Toolbar  -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10" LastChildFill="False">
            <ui:Button Appearance="Primary" Command="{Binding AddFolderCommand}" Content="Add folder" Style="{StaticResource ToolbarButton}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="FolderAdd24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Command="{Binding RescanCommand}" Content="Rescan" Style="{StaticResource ToolbarButton}" ToolTip="Quick rescan: only new or changed files are read">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowSync24" />
                </ui:Button.Icon>
            </ui:Button>

            <Border Width="1" Margin="6,4,12,4" Background="{StaticResource PanelBorderBrush}" />

            <ui:Button Command="{Binding EditInfoCommand}" Content="Edit info" Style="{StaticResource ToolbarButton}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Edit24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Command="{Binding ManageArtCommand}" Content="Art" Style="{StaticResource ToolbarButton}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ImageMultiple24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Command="{Binding RenameCommand}" Content="Rename" Style="{StaticResource ToolbarButton}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Rename24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button Command="{Binding SendToOplCommand}" Content="Send to OPL" Style="{StaticResource ToolbarButton}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="UsbStick24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:DropDownButton Margin="0,0,6,0" Padding="10,6" Content="More">
                <ui:DropDownButton.Icon>
                    <ui:SymbolIcon Symbol="MoreHorizontal24" />
                </ui:DropDownButton.Icon>
                <ui:DropDownButton.Flyout>
                    <ContextMenu>
                        <MenuItem Command="{Binding MoveToFoldersCommand}" Header="Move selected into folders…" />
                        <MenuItem Command="{Binding DownloadArtForSelectionCommand}" Header="Download art for selected" />
                        <MenuItem Command="{Binding ComputeCrcCommand}" Header="Calculate CRC32 for selected" />
                        <MenuItem Command="{Binding RemoveFromLibraryCommand}" Header="Remove selected from library" />
                        <MenuItem Command="{Binding DeleteFilesCommand}" Header="Delete selected files…" />
                        <Separator />
                        <MenuItem Command="{Binding FullRescanCommand}" Header="Full rescan (re-read every disc)" />
                        <MenuItem Command="{Binding ImportLegacyManifestCommand}" Header="Import manifest from old version…" />
                        <MenuItem Command="{Binding ExportCommand}" Header="Export library…" />
                    </ContextMenu>
                </ui:DropDownButton.Flyout>
            </ui:DropDownButton>

            <!--  Right side: view switch  -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <StackPanel Margin="0,0,10,0" Orientation="Horizontal" ToolTip="Cover size" Visibility="{Binding IsCoverView, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Symbol="Image24" />
                    <Slider Width="100" Margin="6,0" VerticalAlignment="Center" Maximum="260" Minimum="100" Value="{Binding CoverSize}" />
                    <ui:SymbolIcon VerticalAlignment="Center" FontSize="18" Foreground="{StaticResource MutedTextBrush}" Symbol="Image24" />
                </StackPanel>
                <ui:Button Command="{Binding ToggleViewCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Switch between list and cover wall">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Grid24" />
                    </ui:Button.Icon>
                    <ui:Button.Content>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Covers" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCoverView}" Value="True">
                                            <Setter Property="Text" Value="List" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ui:Button.Content>
                </ui:Button>
                <ui:Button Margin="6,0,0,0" Command="{Binding ToggleDetailsCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Show or hide the details pane">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="PanelRight24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </DockPanel>

        <!--  Filter bar  -->
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox
                x:Name="SearchBox"
                Grid.Column="0"
                ClearButtonEnabled="True"
                PlaceholderText="Search title, ID, file, developer, genre… (Ctrl+F)"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>
            <ComboBox Grid.Column="1" Width="130" Margin="8,0,0,0" ItemsSource="{Binding RegionOptions}" SelectedItem="{Binding RegionFilter}" />
            <ComboBox Grid.Column="2" Width="125" Margin="8,0,0,0" ItemsSource="{Binding MediaOptions}" SelectedItem="{Binding MediaFilter}" />
            <ComboBox Grid.Column="3" Width="190" Margin="8,0,0,0" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EnumText}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Column="4" Width="170" Margin="8,0,0,0" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}" ToolTip="Sort by">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="ArrowSort24" />
                            <TextBlock Text="{Binding Converter={StaticResource EnumText}}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ui:Button Grid.Column="5" Margin="8,0,0,0" Padding="8" Appearance="Transparent" Command="{Binding ClearFiltersCommand}" ToolTip="Clear filters">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Dismiss24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>

        <!--  List view  -->
        <ui:DataGrid
            x:Name="GamesGrid"
            Grid.Row="2"
            Grid.Column="0"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="True"
            CanUserResizeRows="False"
            ContextMenu="{StaticResource GameMenu}"
            EnableColumnVirtualization="True"
            EnableRowVirtualization="True"
            GridLinesVisibility="None"
            HeadersVisibility="Column"
            HorizontalScrollBarVisibility="Disabled"
            IsReadOnly="True"
            IsTextSearchEnabled="True"
            TextSearch.TextPath="Title"
            ItemsSource="{Binding GamesView}"
            MouseDoubleClick="OnItemDoubleClick"
            RowHeight="38"
            SelectedItem="{Binding SelectedGame}"
            SelectionChanged="OnGridSelectionChanged"
            SelectionMode="Extended"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Recycling"
            Visibility="{Binding IsCoverView, Converter={StaticResource InverseBoolToVis}}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="36" CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type core:GameEntry}">
                            <Border Width="22" Height="31" Background="{StaticResource CoverPlaceholderBrush}" CornerRadius="3">
                                <Image conv:AsyncImage.Path="{Binding CoverPath}" conv:AsyncImage.DecodeWidth="64" Stretch="UniformToFill" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="2.4*" MinWidth="200" Header="Title" SortMemberPath="Title">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type core:GameEntry}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                <Border Margin="8,0,0,0" Padding="6,0" Background="#33B48CFF" CornerRadius="6" ToolTip="You edited this game's info" Visibility="{Binding HasOverrides, Converter={StaticResource BoolToVis}}">
                                    <TextBlock FontSize="11" Foreground="{StaticResource EditedBrush}" Text="edited" />
                                </Border>
                                <Border Margin="6,0,0,0" Padding="6,0" Background="#33F0616D" CornerRadius="6" Visibility="{Binding FileMissing, Converter={StaticResource BoolToVis}}">
                                    <TextBlock FontSize="11" Foreground="{StaticResource DangerBrush}" Text="missing" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="105" Binding="{Binding GameId}" Header="Game ID" />
                <DataGridTextColumn Width="75" Binding="{Binding Region}" Header="Region" />
                <DataGridTextColumn Width="70" Binding="{Binding DiscType}" Header="Media" />
                <DataGridTextColumn Width="50" Binding="{Binding DiscNumber}" Header="Disc" />
                <DataGridTextColumn Width="80" Binding="{Binding SizeDisplay}" Header="Size" SortMemberPath="SizeBytes" />
                <DataGridTextColumn Width="60" Binding="{Binding Version}" Header="Ver" />
                <DataGridTextColumn Width="1.3*" MinWidth="80" Binding="{Binding Genre}" Header="Genre" />
                <DataGridTextColumn Width="1.6*" MinWidth="120" Binding="{Binding FileName}" Header="File" />
            </DataGrid.Columns>
        </ui:DataGrid>

        <!--  Cover wall  -->
        <ListView
            x:Name="CoverWall"
            Grid.Row="2"
            Grid.Column="0"
            Background="Transparent"
            BorderThickness="0"
            ContextMenu="{StaticResource GameMenu}"
            IsTextSearchEnabled="True"
            TextSearch.TextPath="Title"
            ItemsSource="{Binding GamesView}"
            MouseDoubleClick="OnItemDoubleClick"
            ScrollViewer.CanContentScroll="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectedItem="{Binding SelectedGame}"
            SelectionChanged="OnCoverSelectionChanged"
            SelectionMode="Extended"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling"
            Visibility="{Binding IsCoverView, Converter={StaticResource BoolToVis}}">
            <ListView.Resources>
                <conv:BindingProxy x:Key="PageProxy" Data="{Binding}" />
            </ListView.Resources>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ui:VirtualizingWrapPanel Margin="0,0,16,0" MouseWheelDelta="140" ScrollLineDelta="40" Orientation="Vertical" SpacingMode="Uniform" StretchItems="False" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type core:GameEntry}">
                    <StackPanel Width="{Binding Data.CoverSize, Source={StaticResource PageProxy}}" Margin="6" ToolTip="{Binding Title}" ToolTipService.InitialShowDelay="600">
                        <Grid>
                            <Border Height="{Binding Data.CoverSize, Source={StaticResource PageProxy}, Converter={StaticResource CoverHeight}}" Background="{StaticResource CoverPlaceholderBrush}" CornerRadius="6">
                                <Grid>
                                    <TextBlock Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Title}" TextAlignment="Center" TextWrapping="Wrap" />
                                    <Image conv:AsyncImage.Path="{Binding CoverPath}" conv:AsyncImage.DecodeWidth="320" Stretch="UniformToFill" />
                                    <!--  Hover highlight  -->
                                    <Border Background="#1AFFFFFF" CornerRadius="6" Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>
                            <!--  Only badges the box art can't tell you  -->
                            <StackPanel Margin="6" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                                <Border Padding="5,1" Background="#E6B48CFF" CornerRadius="5" ToolTip="You edited this game's info" Visibility="{Binding HasOverrides, Converter={StaticResource BoolToVis}}">
                                    <TextBlock FontSize="10" Foreground="#FF16121F" Text="Edited" />
                                </Border>
                                <Border Margin="4,0,0,0" Padding="5,1" Background="#E6F0616D" CornerRadius="5" Visibility="{Binding FileMissing, Converter={StaticResource BoolToVis}}">
                                    <TextBlock FontSize="10" Foreground="White" Text="Missing file" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="2,6,2,0" FontWeight="SemiBold" MaxHeight="36" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                        <TextBlock Margin="2,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}">
                            <Run Text="{Binding GameId, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Region, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  Empty state  -->
        <Border
            Grid.Row="2"
            Grid.Column="0"
            Style="{StaticResource Panel}"
            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <StackPanel MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon HorizontalAlignment="Center" FontSize="56" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="Library24" />
                <TextBlock Margin="0,12,0,6" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="Your PS2 library is empty" />
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource Muted}" Text="Add the folder that holds your .iso / .bin / .img files. Subfolders are included. You can also drop folders here." TextAlignment="Center" />
                <StackPanel Margin="0,18,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                    <ui:Button Appearance="Primary" Command="{Binding AddFolderCommand}" Content="Add folder">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="FolderAdd24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Margin="8,0,0,0" Command="{Binding ImportLegacyManifestCommand}" Content="Import old manifest" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  Details pane  -->
        <GridSplitter x:Name="DetailsSplitter" Grid.Row="2" Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent" ResizeBehavior="PreviousAndNext" />
        <Border x:Name="DetailsPane" Grid.Row="2" Grid.Column="2" Padding="0" Style="{StaticResource Panel}">
            <Grid>
                <!--  Nothing selected: library overview  -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedGame, Converter={StaticResource NullToVisible}}">
                    <StackPanel Margin="18">
                        <TextBlock Margin="0,0,0,10" Style="{StaticResource SectionHeader}" Text="Library overview" />
                        <ItemsControl ItemsSource="{Binding Stats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LibraryStat}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding Label}" />
                                        <TextBlock x:Name="Value" Grid.Column="1" FontWeight="SemiBold" Text="{Binding Value}" />
                                        <ui:HyperlinkButton
                                            x:Name="Link"
                                            Grid.Column="1"
                                            Padding="4,0"
                                            Command="{Binding DataContext.ApplyStatFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding Value}"
                                            ToolTip="Show these games"
                                            Visibility="Collapsed" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Filter, Converter={StaticResource NullToCollapsed}}" Value="Visible">
                                            <Setter TargetName="Value" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Link" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,14,0,0" Style="{StaticResource Muted}" Text="Select a game to see its details. Type the first letters of a title to jump to it." TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer DataContext="{Binding SelectedGame}" VerticalScrollBarVisibility="Auto" Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                    <StackPanel Margin="18" d:DataContext="{d:DesignInstance core:GameEntry}">
                        <Border MaxWidth="240" MinHeight="120" HorizontalAlignment="Center" Background="{StaticResource CoverPlaceholderBrush}" CornerRadius="8">
                            <Grid>
                                <StackPanel Margin="20,40" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding CoverPath, Converter={StaticResource NullToVisible}}">
                                    <ui:SymbolIcon HorizontalAlignment="Center" FontSize="32" Foreground="{StaticResource MutedTextBrush}" Symbol="Image24" />
                                    <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="No cover" />
                                </StackPanel>
                                <Image conv:AsyncImage.Path="{Binding CoverPath}" conv:AsyncImage.DecodeWidth="480" Stretch="Uniform" />
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,14,0,6" FontSize="18" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />

                        <WrapPanel>
                            <Border Style="{StaticResource Chip}">
                                <TextBlock FontSize="12" Text="{Binding GameId}" />
                            </Border>
                            <Border Style="{StaticResource Chip}" Visibility="{Binding Region, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock FontSize="12" Text="{Binding Region}" />
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <TextBlock FontSize="12" Text="{Binding DiscType}" />
                            </Border>
                            <Border Style="{StaticResource Chip}" Visibility="{Binding IsMultiDisc, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="12">
                                    <Run Text="Disc " /><Run Text="{Binding DiscNumber, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border Background="#33B48CFF" Style="{StaticResource Chip}" Visibility="{Binding HasOverrides, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="12" Foreground="{StaticResource EditedBrush}" Text="Edited" />
                            </Border>
                            <Border Background="#33F2B84B" Style="{StaticResource Chip}" Visibility="{Binding InDatabase, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock FontSize="12" Foreground="{StaticResource WarningBrush}" Text="Not in GameDB" />
                            </Border>
                            <Border Background="#33F0616D" Style="{StaticResource Chip}" Visibility="{Binding IsValid, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock FontSize="12" Foreground="{StaticResource DangerBrush}" Text="{Binding Validity, Converter={StaticResource EnumText}}" />
                            </Border>
                        </WrapPanel>

                        <UniformGrid Margin="0,8,0,0" Columns="3">
                            <ui:Button Margin="0,0,4,0" HorizontalAlignment="Stretch" Command="{Binding DataContext.EditInfoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="Edit" ToolTip="Edit game info">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Edit24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Margin="2,0" HorizontalAlignment="Stretch" Command="{Binding DataContext.ManageArtCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="Art">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ImageMultiple24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Margin="4,0,0,0" HorizontalAlignment="Stretch" Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="Folder">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="FolderOpen24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </UniformGrid>

                        <TextBlock Margin="0,16,0,8" Style="{StaticResource SectionHeader}" Text="Game info" />
                        <Grid>
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Foreground="{StaticResource MutedTextBrush}" Text="Developer" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Developer}" />
                            <TextBlock Grid.Row="1" Foreground="{StaticResource MutedTextBrush}" Text="Publisher" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Publisher}" />
                            <TextBlock Grid.Row="2" Foreground="{StaticResource MutedTextBrush}" Text="Genre" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Genre}" />
                            <TextBlock Grid.Row="3" Foreground="{StaticResource MutedTextBrush}" Text="Released" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Release}" />
                            <TextBlock Grid.Row="4" Foreground="{StaticResource MutedTextBrush}" Text="Languages" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Info.Language}" />
                            <TextBlock Grid.Row="5" Foreground="{StaticResource MutedTextBrush}" Text="Title from" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TitleSource, Converter={StaticResource EnumText}}" />
                        </Grid>

                        <TextBlock Margin="0,4,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Info.Description}" TextWrapping="Wrap" Visibility="{Binding Info.Description, Converter={StaticResource NullToCollapsed}}" />

                        <TextBlock Margin="0,8,0,8" Style="{StaticResource SectionHeader}" Text="Disc &amp; file" />
                        <Grid>
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Foreground="{StaticResource MutedTextBrush}" Text="OPL ID" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OplId}" />
                            <TextBlock Grid.Row="1" Foreground="{StaticResource MutedTextBrush}" Text="Version" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Version}" />
                            <TextBlock Grid.Row="2" Foreground="{StaticResource MutedTextBrush}" Text="Boot ELF" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BootElf}" />
                            <TextBlock Grid.Row="3" Foreground="{StaticResource MutedTextBrush}" Text="Size" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SizeDisplay}" />
                            <TextBlock Grid.Row="4" Foreground="{StaticResource MutedTextBrush}" Text="PCSX2 CRC" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Pcsx2Crc, StringFormat={}{0:X8}}" />
                            <TextBlock Grid.Row="5" Foreground="{StaticResource MutedTextBrush}" Text="CRC32" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Crc32, StringFormat={}{0:X8}, TargetNullValue='not calculated'}" />
                            <TextBlock Grid.Row="6" Foreground="{StaticResource MutedTextBrush}" Text="File" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding FileName}" />
                            <TextBlock Grid.Row="7" Foreground="{StaticResource MutedTextBrush}" Text="Folder" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Directory}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
