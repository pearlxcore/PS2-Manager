<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PS2Manager.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DiscUtils.Iso9660" Version="0.16.13" />
    <PackageReference Include="SharpCompress" Version="0.50.7" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.0" />
  </ItemGroup>

  <!-- Save-state conversion catalog (from PCSX2 SaveState Converter), read by SaveStates/ShippedData. -->
  <ItemGroup>
    <EmbeddedResource Include="SaveStates/catalog/stable-formats.json" LogicalName="catalog/stable-formats.json" />
    <EmbeddedResource Include="SaveStates/catalog/routes.json" LogicalName="catalog/routes.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PS2Manager.Tests" />
  </ItemGroup>

</Project>
